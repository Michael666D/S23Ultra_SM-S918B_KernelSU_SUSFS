@@ -0,0 +1,29 @@
+name: WildQ pinned dependencies
+description: Clone the W0-era dependency trees by immutable commit.
+runs:
+  using: composite
+  steps:
+    - shell: bash
+      run: |
+        set -euo pipefail
+        clone_at() {
+          local url="$1" sha="$2" dir="$3"
+          rm -rf "$dir"
+          git init -q "$dir"
+          git -C "$dir" remote add origin "$url"
+          git -C "$dir" fetch --depth=1 origin "$sha"
+          git -C "$dir" checkout --detach FETCH_HEAD
+          test "$(git -C "$dir" rev-parse HEAD)" = "$sha"
+        }
+
+        clone_at "https://github.com/WildKernels/kernel_patches.git" \
+          "f569cc9e69d6f03a488c391db4cc00db8ead7a59" \
+          "$GITHUB_WORKSPACE/kernel_patches"
+
+        clone_at "https://github.com/WildKernels/AnyKernel3.git" \
+          "e1e9dce98430c5c6f231f7094a8c7f4ecaf50948" \
+          "$GITHUB_WORKSPACE/AnyKernel3"
+
+        echo "ROOT=$GITHUB_WORKSPACE" >> "$GITHUB_ENV"
+        echo "KERNEL_PATCHES=$GITHUB_WORKSPACE/kernel_patches" >> "$GITHUB_ENV"
+        echo "ANYKERNEL3=$GITHUB_WORKSPACE/AnyKernel3" >> "$GITHUB_ENV"
diff --git a/.github/actions/wildq-kpm/action.yml b/.github/actions/wildq-kpm/action.yml
new file mode 100644
index 0000000..983fde2
--- /dev/null
+++ b/.github/actions/wildq-kpm/action.yml
@@ -0,0 +1,115 @@
+name: WildQ Suki KernelPatch/KPM
+description: Apply Suki's KernelPatch exactly once to the canonical Image, with double-patch guards.
+runs:
+  using: composite
+  steps:
+    - shell: bash
+      run: |
+        set -euo pipefail
+        : "${KERNEL_IMAGE:?KERNEL_IMAGE is not set}"
+
+        REPORT_DIR="$GITHUB_WORKSPACE/wildq-out"
+        mkdir -p "$REPORT_DIR"
+
+        count_marker() {
+          local file="$1" marker="$2"
+          # grep exits 1 for zero matches; wc still provides 0.
+          strings -a "$file" | grep -F "$marker" -c || true
+        }
+
+        pre_kp_ver="$(count_marker "$KERNEL_IMAGE" 'KernelPatch Version')"
+        pre_kp_cfg="$(count_marker "$KERNEL_IMAGE" 'KernelPatch Config')"
+        pre_api="$(count_marker "$KERNEL_IMAGE" 'sukisu_handle_kpm')"
+        pre_load="$(count_marker "$KERNEL_IMAGE" 'SUKISU_KPM_LOAD')"
+
+        {
+          echo "pre_sha256=$(sha256sum "$KERNEL_IMAGE" | awk '{print $1}')"
+          echo "pre_size=$(stat -c %s "$KERNEL_IMAGE")"
+          echo "pre_kernelpatch_version_count=$pre_kp_ver"
+          echo "pre_kernelpatch_config_count=$pre_kp_cfg"
+          echo "pre_sukisu_handle_kpm_count=$pre_api"
+          echo "pre_sukisu_kpm_load_count=$pre_load"
+        } | tee "$REPORT_DIR/kpm-precheck.txt"
+
+        # The source-side Suki KPM API is EXPECTED before post-build KernelPatch.
+        # The KernelPatch core is NOT expected before this action.
+        if [ "$pre_kp_ver" -ne 0 ] || [ "$pre_kp_cfg" -ne 0 ]; then
+          echo "ERROR: Image already contains KernelPatch core markers. Refusing to patch twice."
+          exit 40
+        fi
+        if [ "$pre_api" -lt 1 ] || [ "$pre_load" -lt 1 ]; then
+          echo "ERROR: CONFIG_KPM/source-side Suki KPM API not found in pre-patch Image."
+          echo "Refusing to turn a non-KPM build into KPM only by binary injection."
+          exit 41
+        fi
+
+        PATCH_SHA="547ae94bcaec53d030398f857950c64662043a5d"
+        PATCH_REPO="$GITHUB_WORKSPACE/SukiSU_patch"
+        rm -rf "$PATCH_REPO"
+        git init -q "$PATCH_REPO"
+        git -C "$PATCH_REPO" remote add origin https://github.com/SukiSU-Ultra/SukiSU_patch.git
+        git -C "$PATCH_REPO" fetch --depth=1 origin "$PATCH_SHA"
+        git -C "$PATCH_REPO" checkout --detach FETCH_HEAD
+        test "$(git -C "$PATCH_REPO" rev-parse HEAD)" = "$PATCH_SHA"
+
+        PATCH_LINUX="$PATCH_REPO/kpm/patch_linux"
+        test -f "$PATCH_LINUX"
+        chmod +x "$PATCH_LINUX"
+        sha256sum "$PATCH_LINUX" | tee "$REPORT_DIR/patch_linux.sha256"
+
+        TMP="$(mktemp -d)"
+        trap 'rm -rf "$TMP"' EXIT
+        cp "$KERNEL_IMAGE" "$TMP/Image"
+        cp "$PATCH_LINUX" "$TMP/patch_linux"
+
+        # Verified upstream interface: patch_linux is run with no CLI arguments,
+        # consumes ./Image and produces ./oImage.
+        (
+          cd "$TMP"
+          set +e
+          ./patch_linux 2>&1 | tee "$REPORT_DIR/patch_linux.log"
+          rc=${PIPESTATUS[0]}
+          set -e
+          echo "$rc" > "$REPORT_DIR/patch_linux.exitcode"
+        )
+
+        test -s "$TMP/oImage" || {
+          echo "ERROR: patch_linux did not produce a non-empty oImage."
+          exit 42
+        }
+
+        pre_sha="$(sha256sum "$KERNEL_IMAGE" | awk '{print $1}')"
+        post_sha="$(sha256sum "$TMP/oImage" | awk '{print $1}')"
+        [ "$pre_sha" != "$post_sha" ] || {
+          echo "ERROR: oImage hash equals input Image hash."
+          exit 43
+        }
+
+        post_kp_ver="$(count_marker "$TMP/oImage" 'KernelPatch Version')"
+        post_kp_cfg="$(count_marker "$TMP/oImage" 'KernelPatch Config')"
+        post_api="$(count_marker "$TMP/oImage" 'sukisu_handle_kpm')"
+        post_load="$(count_marker "$TMP/oImage" 'SUKISU_KPM_LOAD')"
+
+        {
+          echo "post_sha256=$post_sha"
+          echo "post_size=$(stat -c %s "$TMP/oImage")"
+          echo "post_kernelpatch_version_count=$post_kp_ver"
+          echo "post_kernelpatch_config_count=$post_kp_cfg"
+          echo "post_sukisu_handle_kpm_count=$post_api"
+          echo "post_sukisu_kpm_load_count=$post_load"
+        } | tee "$REPORT_DIR/kpm-postcheck.txt"
+
+        if [ "$post_kp_ver" -ne 1 ] || [ "$post_kp_cfg" -ne 1 ]; then
+          echo "ERROR: expected exactly one KernelPatch core after patching."
+          exit 44
+        fi
+        if [ "$post_api" -lt 1 ] || [ "$post_load" -lt 1 ]; then
+          echo "ERROR: source-side Suki KPM API disappeared after patching."
+          exit 45
+        fi
+
+        cp "$TMP/oImage" "$KERNEL_IMAGE"
+        cp "$TMP/oImage" "$REPORT_DIR/Image.kpm"
+        echo "SUKI_PATCH_COMMIT=$PATCH_SHA" >> "$GITHUB_ENV"
+        echo "KPM_PATCHED=true" >> "$GITHUB_ENV"
+        echo "KernelPatch applied exactly once."
diff --git a/.github/actions/wildq-locate-image/action.yml b/.github/actions/wildq-locate-image/action.yml
new file mode 100644
index 0000000..dd46545
--- /dev/null
+++ b/.github/actions/wildq-locate-image/action.yml
@@ -0,0 +1,53 @@
+name: WildQ locate canonical Image
+description: Select the final Bazel Image once and make a canonical copy used by KPM and AnyKernel.
+runs:
+  using: composite
+  steps:
+    - shell: bash
+      run: |
+        set -euo pipefail
+        OUT="$GITHUB_WORKSPACE/wildq-out"
+        mkdir -p "$OUT"
+
+        candidates=(
+          "$CONFIG/kernel_platform/bazel-bin/common/kernel_aarch64/Image"
+          "$CONFIG/kernel_platform/bazel-bin/common/kernel_aarch64/kernel_aarch64/Image"
+          "$CONFIG/out/msm-kalama-kalama-gki/dist/Image"
+        )
+
+        found=""
+        for p in "${candidates[@]}"; do
+          if [ -f "$p" ]; then
+            found="$p"
+            break
+          fi
+        done
+
+        if [ -z "$found" ]; then
+          mapfile -t images < <(
+            find "$CONFIG" -type f -name Image \
+              ! -path '*/.git/*' \
+              ! -path '*/KernelSU/*' \
+              ! -path '*/AnyKernel3/*' \
+              | grep -E '/(bazel-bin|kbuild_mixed_tree|/dist/|kernel_aarch64)/' \
+              | sort -u
+          )
+          if [ "${#images[@]}" -ne 1 ]; then
+            echo "ERROR: canonical Image could not be selected unambiguously."
+            printf 'candidate: %s\n' "${images[@]:-<none>}"
+            exit 30
+          fi
+          found="${images[0]}"
+        fi
+
+        canonical="$OUT/Image"
+        cp --reflink=auto "$found" "$canonical"
+        cp --reflink=auto "$found" "$OUT/Image.orig"
+
+        test -s "$canonical"
+        echo "KERNEL_BUILD_IMAGE=$found" >> "$GITHUB_ENV"
+        echo "KERNEL_IMAGE=$canonical" >> "$GITHUB_ENV"
+
+        echo "Build Image: $found"
+        echo "Canonical:   $canonical"
+        sha256sum "$found" "$canonical" "$OUT/Image.orig"
diff --git a/.github/actions/wildq-stage-ak3/action.yml b/.github/actions/wildq-stage-ak3/action.yml
new file mode 100644
index 0000000..cfb9c6c
--- /dev/null
+++ b/.github/actions/wildq-stage-ak3/action.yml
@@ -0,0 +1,41 @@
+name: WildQ stage AnyKernel3
+description: Stage exactly the canonical Image validated by WildQ; no heuristic Image rediscovery.
+inputs:
+  stage:
+    required: true
+runs:
+  using: composite
+  steps:
+    - shell: bash
+      run: |
+        set -euo pipefail
+        : "${KERNEL_IMAGE:?KERNEL_IMAGE is not set}"
+        : "${ANYKERNEL3:?ANYKERNEL3 is not set}"
+
+        test -s "$KERNEL_IMAGE"
+        rm -f "$ANYKERNEL3/Image" "$ANYKERNEL3/Image.gz"
+        cp "$KERNEL_IMAGE" "$ANYKERNEL3/Image"
+
+        src="$(sha256sum "$KERNEL_IMAGE" | awk '{print $1}')"
+        dst="$(sha256sum "$ANYKERNEL3/Image" | awk '{print $1}')"
+        [ "$src" = "$dst" ] || {
+          echo "ERROR: staged AnyKernel Image is not the canonical Image."
+          exit 50
+        }
+
+        FILE_NAME="SM-S918B-Oneui8.5-WildQ-${{ inputs.stage }}-Suki"
+        if [ "${{ inputs.stage }}" = "W2" ]; then FILE_NAME="${FILE_NAME}-SUSFS"; fi
+        if [ "${{ inputs.stage }}" = "W3" ]; then FILE_NAME="${FILE_NAME}-SUSFS-KPM"; fi
+        echo "FILE_NAME=$FILE_NAME" >> "$GITHUB_ENV"
+
+        python3 "$GITHUB_WORKSPACE/scripts/wildq_scan_image.py" \
+          "$KERNEL_IMAGE" \
+          --output "$GITHUB_WORKSPACE/wildq-out/final-image.json"
+
+        (
+          cd "$ANYKERNEL3"
+          zip -r9 "$GITHUB_WORKSPACE/${FILE_NAME}.zip" . \
+            -x '.git/*' '.github/*' >/dev/null
+        )
+        sha256sum "$GITHUB_WORKSPACE/${FILE_NAME}.zip" \
+          | tee "$GITHUB_WORKSPACE/wildq-out/final-zip.sha256"
diff --git a/.github/actions/wildq-sukisu/action.yml b/.github/actions/wildq-sukisu/action.yml
new file mode 100644
index 0000000..99cd70e
--- /dev/null
+++ b/.github/actions/wildq-sukisu/action.yml
@@ -0,0 +1,78 @@
+name: WildQ SukiSU
+description: Integrate the exact SukiSU revision observed in the known-good qlenlen binary.
+inputs:
+  kpm:
+    description: Enable SukiSU CONFIG_KPM source-side support (post-build KernelPatch is separate).
+    required: true
+  susfs:
+    description: Enable SukiSU SUSFS interface. Kernel-side SUSFS patching is a separate step.
+    required: true
+runs:
+  using: composite
+  steps:
+    - shell: bash
+      run: |
+        set -euo pipefail
+
+        SUKI_SHA="b1d534bc41941b2c818d7a1a1dac341e4aabfc2d"
+        GKI_ROOT="$CONFIG/kernel_platform"
+        SUKI_DIR="$GKI_ROOT/KernelSU"
+        DRIVER_DIR="$COMMON/drivers"
+        DRIVER_MAKEFILE="$DRIVER_DIR/Makefile"
+        DRIVER_KCONFIG="$DRIVER_DIR/Kconfig"
+
+        # Refuse a mixed root-framework source tree.
+        if [ -e "$GKI_ROOT/KernelSU-Next" ] || [ -e "$COMMON/KernelSU-Next" ]; then
+          echo "ERROR: KernelSU-Next tree already present. WildQ W1-W3 must not mix KSUN and SukiSU."
+          exit 20
+        fi
+
+        rm -rf "$SUKI_DIR"
+        git init -q "$SUKI_DIR"
+        git -C "$SUKI_DIR" remote add origin https://github.com/SukiSU-Ultra/SukiSU-Ultra.git
+        git -C "$SUKI_DIR" fetch --depth=1 origin "$SUKI_SHA"
+        git -C "$SUKI_DIR" checkout --detach FETCH_HEAD
+        test "$(git -C "$SUKI_DIR" rev-parse HEAD)" = "$SUKI_SHA"
+
+        rm -f "$DRIVER_DIR/kernelsu"
+        ln -s "$(realpath --relative-to="$DRIVER_DIR" "$SUKI_DIR/kernel")" "$DRIVER_DIR/kernelsu"
+
+        grep -q 'obj-$(CONFIG_KSU) += kernelsu/' "$DRIVER_MAKEFILE" || \
+          printf '\nobj-$(CONFIG_KSU) += kernelsu/\n' >> "$DRIVER_MAKEFILE"
+
+        grep -q 'source "drivers/kernelsu/Kconfig"' "$DRIVER_KCONFIG" || \
+          sed -i '/endmenu/i\source "drivers/kernelsu/Kconfig"' "$DRIVER_KCONFIG"
+
+        "$COMMON/scripts/config" --file "$GKI_DEFCONFIG" --enable CONFIG_KSU
+
+        if [ "${{ inputs.susfs }}" = "true" ]; then
+          "$COMMON/scripts/config" --file "$GKI_DEFCONFIG" --enable CONFIG_KSU_SUSFS
+        else
+          # Suki v4.1.3 has CONFIG_KSU_SUSFS default y. W1 must explicitly
+          # disable it because W1 intentionally has no SUSFS kernel patch.
+          "$COMMON/scripts/config" --file "$GKI_DEFCONFIG" --disable CONFIG_KSU_SUSFS
+        fi
+
+        if [ "${{ inputs.kpm }}" = "true" ]; then
+          "$COMMON/scripts/config" --file "$GKI_DEFCONFIG" --enable CONFIG_KPM
+          "$COMMON/scripts/config" --file "$GKI_DEFCONFIG" --enable CONFIG_KALLSYMS
+          "$COMMON/scripts/config" --file "$GKI_DEFCONFIG" --enable CONFIG_KALLSYMS_ALL
+        else
+          "$COMMON/scripts/config" --file "$GKI_DEFCONFIG" --disable CONFIG_KPM
+        fi
+
+        # Suki Kconfig requires KSU && 64BIT; KSU itself expects the kernel prerequisites.
+        grep -q '^CONFIG_64BIT=y' "$GKI_DEFCONFIG" || {
+          echo "ERROR: CONFIG_64BIT=y missing"; exit 21;
+        }
+        grep -q '^CONFIG_KPROBES=y' "$GKI_DEFCONFIG" || {
+          echo "ERROR: CONFIG_KPROBES=y missing"; exit 22;
+        }
+
+        {
+          echo "SUKI_COMMIT=$SUKI_SHA"
+          echo "SUKI_DIR=$SUKI_DIR"
+        } >> "$GITHUB_ENV"
+
+        echo "SukiSU integrated at $SUKI_SHA"
+        grep -E '^(CONFIG_KSU|CONFIG_KPM|CONFIG_KSU_SUSFS|CONFIG_KALLSYMS|CONFIG_KALLSYMS_ALL)=' "$GKI_DEFCONFIG" || true
diff --git a/.github/workflows/wildq-sm918b.yml b/.github/workflows/wildq-sm918b.yml
new file mode 100644
index 0000000..eb55c9c
--- /dev/null
+++ b/.github/workflows/wildq-sm918b.yml
@@ -0,0 +1,236 @@
+name: WildQ SM-S918B W1-W3
+
+on:
+  workflow_dispatch:
+    inputs:
+      stage:
+        description: "W1=Suki only; W2=Suki+SUSFS; W3=Suki+SUSFS+KPM"
+        required: true
+        type: choice
+        options:
+          - W1
+          - W2
+          - W3
+        default: W1
+
+permissions:
+  contents: read
+
+jobs:
+  wildq:
+    name: "SM-S918B OneUI8.5 ${{ inputs.stage }}"
+    runs-on: ubuntu-latest
+    timeout-minutes: 180
+
+    steps:
+      - name: Checkout WildQ overlay repository
+        uses: actions/checkout@v5
+        with:
+          fetch-depth: 0
+
+      - name: Verify Wild base ancestry
+        shell: bash
+        run: |
+          set -euo pipefail
+          BASE="87a2cca5c6a4ac468446f3513119f95431dbee4a"
+          git cat-file -e "$BASE^{commit}" || {
+            echo "ERROR: Wild base $BASE is not in this repository history."
+            echo "Create the WildQ branch from WildKernels/Samsung_KernelSU_SUSFS@$BASE first."
+            exit 2
+          }
+          git merge-base --is-ancestor "$BASE" HEAD || {
+            echo "ERROR: current branch is not based on the audited Wild W0 commit."
+            exit 3
+          }
+
+      - name: Free disk space (same strategy family as Wild W0)
+        uses: endersonmenezes/free-disk-space@v3
+        with:
+          remove_android: true
+          remove_dotnet: true
+          remove_haskell: true
+          remove_tool_cache: true
+          remove_swap: true
+          remove_packages: "azure-cli google-cloud-cli microsoft-edge-stable google-chrome-stable firefox postgresql* temurin-* *llvm* mysql* dotnet-sdk-*"
+          remove_packages_one_command: true
+          remove_folders: "/usr/share/swift /usr/share/miniconda /usr/share/az* /usr/local/lib/node_modules /usr/local/share/chromium /usr/local/share/powershell /usr/local/julia /usr/local/aws-cli /usr/local/aws-sam-cli /usr/share/gradle"
+          rm_cmd: "rmz"
+          rmz_version: "3.1.1"
+          testing: false
+
+      - name: Setup swap for Full LTO
+        uses: thejerrybao/setup-swap-space@v1
+        with:
+          swap-size-gb: 25
+
+      - name: Set fixed WildQ environment
+        shell: bash
+        run: |
+          set -euo pipefail
+          {
+            echo "ROOT=$GITHUB_WORKSPACE"
+            echo "BRANCH=SM-S918B-Oneui8.5"
+            echo "ANDROID_VER=android13"
+            echo "KERNEL_VER=5.15"
+            echo "WILDQ_STAGE=${{ inputs.stage }}"
+          } >> "$GITHUB_ENV"
+          mkdir -p "$GITHUB_WORKSPACE/wildq-out"
+
+      - name: Clone pinned W0 dependencies
+        uses: ./.github/actions/wildq-dependencies
+
+      - name: Clone pinned Samsung SM-S918B source
+        uses: ./.github/actions/wildq-clone-kernel
+
+      - name: Extract Samsung source tar.xz payloads
+        shell: bash
+        run: |
+          set -euo pipefail
+          cd "$CONFIG"
+          find . -type f -name '*.tar.xz' -print0 | while IFS= read -r -d '' file; do
+            echo "Extracting $file"
+            tar -xf "$file"
+            rm "$file"
+          done
+
+      - name: Integrate SukiSU
+        uses: ./.github/actions/wildq-sukisu
+        with:
+          kpm: ${{ inputs.stage == 'W3' && 'true' || 'false' }}
+          susfs: ${{ inputs.stage != 'W1' && 'true' || 'false' }}
+
+      # W2/W3 deliberately reuse the audited Wild SUSFS kernel-side action first.
+      # It still contains mutable Simonpunk/Pershoot fetches; the next step records
+      # the exact runtime commit so the successful combination can be pinned.
+      - name: Add SUSFS using Wild W0-era integration
+        if: inputs.stage == 'W2' || inputs.stage == 'W3'
+        uses: ./.github/actions/susfs-patches
+
+      - name: Record SUSFS runtime revision
+        if: inputs.stage == 'W2' || inputs.stage == 'W3'
+        shell: bash
+        run: |
+          set -euo pipefail
+          if [ -d "$GITHUB_WORKSPACE/susfs4ksu/.git" ]; then
+            {
+              echo "susfs_head=$(git -C "$GITHUB_WORKSPACE/susfs4ksu" rev-parse HEAD)"
+              echo "susfs_history:"
+              git -C "$GITHUB_WORKSPACE/susfs4ksu" log -n 5 --format='%H %s'
+            } | tee "$GITHUB_WORKSPACE/wildq-out/susfs-runtime.txt"
+          else
+            echo "ERROR: susfs4ksu working tree missing."
+            exit 4
+          fi
+
+      # Important: Wild W0 only ran this because KSUN=true. WildQ runs it
+      # explicitly so changing the root engine does NOT silently change the
+      # Samsung security/config policy during W1-W3.
+      - name: Preserve Wild W0 kernel configuration policy
+        uses: ./.github/actions/configs
+
+      - name: Fail on unresolved patch rejects
+        shell: bash
+        run: |
+          set -euo pipefail
+          mapfile -t rejects < <(find "$CONFIG" -type f -name '*.rej' -print)
+          if [ "${#rejects[@]}" -gt 0 ]; then
+            echo "ERROR: unresolved patch rejects remain after integration:"
+            printf '  %s\n' "${rejects[@]}"
+            exit 5
+          fi
+          echo "No unresolved .rej files."
+
+      - name: Keep Wild kernel naming behavior
+        uses: ./.github/actions/kernel-name
+
+      - name: Keep Wild ABI export behavior
+        uses: ./.github/actions/abi-export
+
+      - name: Keep Wild Full LTO behavior
+        uses: ./.github/actions/lto
+
+      - name: Snapshot final requested defconfig
+        shell: bash
+        run: |
+          set -euo pipefail
+          cp "$GKI_DEFCONFIG" "$GITHUB_WORKSPACE/wildq-out/gki_defconfig.requested"
+          sha256sum "$GKI_DEFCONFIG" | tee "$GITHUB_WORKSPACE/wildq-out/gki_defconfig.sha256"
+          grep -E '^(CONFIG_KSU|CONFIG_KPM|CONFIG_KSU_SUSFS|CONFIG_KALLSYMS|CONFIG_KALLSYMS_ALL|CONFIG_LTO|CONFIG_LTO_CLANG|CONFIG_LTO_CLANG_FULL|CONFIG_CFI_CLANG|CONFIG_MODULES|CONFIG_MODVERSIONS|CONFIG_MODULE_SIG|CONFIG_MODULE_SIG_PROTECT|CONFIG_SECURITY_DEFEX|CONFIG_FIVE|CONFIG_PROCA|CONFIG_RKP|CONFIG_KDP)=' \
+            "$GKI_DEFCONFIG" | tee "$GITHUB_WORKSPACE/wildq-out/key-configs.txt" || true
+
+      - name: Build GKI kernel
+        uses: ./.github/actions/build
+        with:
+          build_type: Bazel
+
+      - name: Locate canonical final Image
+        uses: ./.github/actions/wildq-locate-image
+
+      - name: Scan pre-KernelPatch Image
+        shell: bash
+        run: |
+          set -euo pipefail
+          python3 "$GITHUB_WORKSPACE/scripts/wildq_scan_image.py" \
+            "$KERNEL_IMAGE" \
+            --output "$GITHUB_WORKSPACE/wildq-out/pre-kpatch-image.json"
+
+      - name: Apply Suki KernelPatch exactly once
+        if: inputs.stage == 'W3'
+        uses: ./.github/actions/wildq-kpm
+
+      - name: Stage canonical Image into AnyKernel3
+        uses: ./.github/actions/wildq-stage-ak3
+        with:
+          stage: ${{ inputs.stage }}
+
+      - name: Write build manifest
+        shell: bash
+        run: |
+          set -euo pipefail
+          cat > "$GITHUB_WORKSPACE/wildq-out/build-manifest.txt" <<EOF
+          WildQ stage: ${{ inputs.stage }}
+          Device: SM-S918B
+          Codename: dm3q
+          SoC: SM8550/Kalama
+          Wild audited base: 87a2cca5c6a4ac468446f3513119f95431dbee4a
+          Samsung source: $(git -C "$CONFIG" rev-parse HEAD)
+          SukiSU: $(git -C "$SUKI_DIR" rev-parse HEAD)
+          kernel_patches: $(git -C "$KERNEL_PATCHES" rev-parse HEAD)
+          AnyKernel3: $(git -C "$ANYKERNEL3" rev-parse HEAD)
+          Bazel target: //common:kernel_aarch64
+          Kernel build image: $KERNEL_BUILD_IMAGE
+          Canonical image: $KERNEL_IMAGE
+          Kernel image SHA256: $(sha256sum "$KERNEL_IMAGE" | awk '{print $1}')
+          Kernel image size: $(stat -c %s "$KERNEL_IMAGE")
+          KPM patched: ${KPM_PATCHED:-false}
+          Suki patch commit: ${SUKI_PATCH_COMMIT:-not-used}
+          EOF
+          if [ -f "$GITHUB_WORKSPACE/wildq-out/susfs-runtime.txt" ]; then
+            cat "$GITHUB_WORKSPACE/wildq-out/susfs-runtime.txt" >> "$GITHUB_WORKSPACE/wildq-out/build-manifest.txt"
+          fi
+          cat "$GITHUB_WORKSPACE/wildq-out/build-manifest.txt"
+
+      - name: Collect patch rejects
+        if: always()
+        shell: bash
+        run: |
+          mkdir -p "$GITHUB_WORKSPACE/wildq-out/rejects"
+          find "${CONFIG:-/nonexistent}" -type f -name '*.rej' -print -exec cp --parents {} "$GITHUB_WORKSPACE/wildq-out/rejects/" \; 2>/dev/null || true
+
+      - name: Upload installable ZIP
+        uses: actions/upload-artifact@v6
+        with:
+          name: "WildQ-${{ inputs.stage }}-SM-S918B"
+          path: "SM-S918B-Oneui8.5-WildQ-${{ inputs.stage }}-Suki*.zip"
+          if-no-files-found: error
+          compression-level: 0
+
+      - name: Upload diagnostics and manifests
+        if: always()
+        uses: actions/upload-artifact@v6
+        with:
+          name: "WildQ-${{ inputs.stage }}-diagnostics"
+          path: |
+            wildq-out/**
+          if-no-files-found: warn
+          compression-level: 9
